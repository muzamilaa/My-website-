<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gift App</title>  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f6fa;
      color: #222;
    }

    header {
      background: #111827;
      color: white;
      padding: 18px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    header h1 {
      font-size: 24px;
    }

    .hero {
      background: linear-gradient(135deg, #7c3aed, #ec4899);
      color: white;
      padding: 55px 20px;
      text-align: center;
    }

    .hero h2 {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .hero p {
      font-size: 17px;
      opacity: 0.95;
    }

    .container {
      max-width: 1100px;
      margin: 30px auto;
      padding: 0 18px;
    }

    .section-title {
      margin-bottom: 20px;
      font-size: 25px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 5px 18px rgba(0,0,0,0.08);
    }

    .card h3 {
      margin-bottom: 10px;
      color: #4f46e5;
    }

    .card p {
      color: #555;
      line-height: 1.5;
    }

    .btn {
      display: inline-block;
      margin-top: 15px;
      padding: 11px 18px;
      border-radius: 8px;
      background: #4f46e5;
      color: white;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .announcement {
      background: #fff7ed;
      border-left: 5px solid #f97316;
      padding: 16px;
      margin-bottom: 25px;
      border-radius: 8px;
    }

    footer {
      margin-top: 50px;
      background: #111827;
      color: white;
      text-align: center;
      padding: 25px;
    }

    @media (max-width: 600px) {
      .hero h2 {
        font-size: 28px;
      }

      header h1 {
        font-size: 20px;
      }
    }
  </style></head><body>  <header>
    <h1>🎁 Gift App</h1>
    <span>Welcome</span>
  </header>  <section class="hero">
    <h2>Welcome to Gift App</h2>
    <p>Discover amazing gifts, offers and special content.</p>
  </section>  <main class="container"><div class="announcement">
  <strong>📢 Announcement</strong>
  <p>Welcome to our Gift App website!</p>
</div>

<h2 class="section-title">Featured Gifts</h2>

<div class="grid">

  <div class="card">
    <h3>🎁 Special Gift</h3>
    <p>Explore our latest special gifts and offers.</p>
    <button class="btn" onclick="showMessage()">View Gift</button>
  </div>

  <div class="card">
    <h3>💎 Premium Gift</h3>
    <p>Check out premium gifts available in the app.</p>
    <button class="btn" onclick="showMessage()">View Gift</button>
  </div>

  <div class="card">
    <h3>🔥 Latest Offers</h3>
    <p>Find the newest offers and exciting rewards.</p>
    <button class="btn" onclick="showMessage()">View Offers</button>
  </div>

</div>

  </main>  <footer>
    <p>© 2026 Gift App. All Rights Reserved.</p>
  </footer>  <script>
    function showMessage() {
      alert("Gift details will be available soon!");
    }
  </script></body>
</html>
